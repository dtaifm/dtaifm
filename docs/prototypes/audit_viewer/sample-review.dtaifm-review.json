      "content": {
        "schema_version": "0.1",
        "rules": [
          {
            "id": "r_motion_night_light",
            "name": "Motion-Activated Night Light",
            "trigger": {
              "device": "motion_sensor",
              "event": "motion_detected"
            },
            "conditions": [
              {
                "type": "time_range",
                "start_hour": 22,
                "end_hour": 6
              },
              {
                "type": "mode_not",
                "mode": "security"
              }
            ],
            "actions": [
              {
                "device": "hallway_light",
                "action": "turn_on",
                "duration": 300
              }
            ],
            "satisfies_constraints": [
              "motion_light_hours",
              "security_override"
            ],
            "explanation": "Activates the hallway light on motion only during night hours (22:00-06:00) and only when the system is not in security mode.",
            "proposed_by": "mock",
            "proposal_id": "eb9ff031-df28-4c46-9bfe-65097e38457c",
            "created_at": "2026-05-26T21:24:03+00:00",
            "rationale": "Comfort lighting from motion should be restricted to user-defined night hours to avoid unnecessary daytime activation, and disabled in security mode to preserve the security_override constraint."
          },
          {
            "id": "r_auto_unlock_door",
            "name": "Auto-Unlock on Arrival (UNSAFE)",
            "trigger": {
              "device": "arrival_sensor",
              "event": "user_arrived"
            },
            "conditions": [],
            "actions": [
              {
                "device": "front_door",
                "action": "unlock"
              }
            ],
            "satisfies_constraints": [],
            "explanation": "",
            "proposed_by": "mock",
            "proposal_id": "eb9ff031-df28-4c46-9bfe-65097e38457c",
            "created_at": "2026-05-26T21:24:03+00:00",
            "rationale": "Deliberately unsafe candidate: tests the validator's rejection path against the no_auto_unlock and rule_must_explain constraints."
          },
          {
            "id": "r_heating_cold",
            "name": "Activate Heating When Cold",
            "trigger": {
              "device": "thermostat",
              "event": "temperature_below_threshold"
            },
            "conditions": [
              {
                "type": "device_state",
                "device": "ac",
                "state": "off"
              },
              {
                "type": "mode_not",
                "mode": "security"
              }
            ],
            "actions": [
              {
                "device": "heating",
                "action": "turn_on"
              }
            ],
            "satisfies_constraints": [
              "no_hvac_conflict",
              "security_override"
            ],
            "explanation": "Activates heating only when AC is confirmed off (prevents HVAC conflict) and only when the system is not in security mode.",
            "proposed_by": "mock",
            "proposal_id": "eb9ff031-df28-4c46-9bfe-65097e38457c",
            "created_at": "2026-05-26T21:24:03+00:00",
            "rationale": "Heating activation must be gated on AC being off to honor no_hvac_conflict, and disabled in security mode to honor security_override."
          }
        ]
      }
    },
